# ЕГЭ №21. Теория игр — стратегия Вани

# ============================================================
# БЛОК 1. ВСЕ ВОЗМОЖНЫЕ ХОДЫ
# ============================================================
def moves(x, y):
    return (
        (x + 4, y),
        (x, y + 4),
        (x * 2, y),
        (x, y * 2)
    )

# ============================================================
# БЛОК 2. ПОБЕДА ЗА ОДИН ХОД
# ============================================================
def win1(x, y):
    return x + y < 133 and any(
        sum(p) >= 133
        for p in moves(x, y)
    )

# ============================================================
# БЛОК 3. ПРОИГРЫШНАЯ ПОЗИЦИЯ
# ============================================================
# Любой ход отдаёт сопернику победу за один ход.
def lose1(x, y):
    return x + y < 133 and all(
        win1(*p)
        for p in moves(x, y)
    )

# ============================================================
# БЛОК 4. ПОБЕДА СВОИМ ВТОРЫМ ХОДОМ
# ============================================================
def win2(x, y):
    return not win1(x, y) and any(
        lose1(*p)
        for p in moves(x, y)
    )

# ============================================================
# БЛОК 5. ПОБЕДА ПЕРВЫМ ИЛИ ВТОРЫМ ХОДОМ
# ============================================================
def win12(x, y):
    return win1(x, y) or win2(x, y)

# ============================================================
# БЛОК 6. РЕШЕНИЕ №21 ЧЕРЕЗ ПОНЯТНЫЕ ПОЗИЦИИ
# ============================================================
# Ваня должен выиграть первым или вторым ходом
# при ЛЮБОМ первом ходе Пети.
# Но Ваня не должен гарантированно выигрывать сразу.

for S in range(1, 116):
    first_moves = moves(17, S)

    can_win_in_1_or_2 = all(
        win12(*p)
        for p in first_moves
    )

    can_always_win_in_1 = all(
        win1(*p)
        for p in first_moves
    )

    if can_win_in_1_or_2 and not can_always_win_in_1:
        print(S)
        break

# ============================================================
# БЛОК 7. КОРОТКАЯ ЗАПИСЬ ТОГО ЖЕ РЕШЕНИЯ
# ============================================================
for S in range(1, 116):
    if (
        all(win12(*p) for p in moves(17, S))
        and not all(win1(*p) for p in moves(17, S))
    ):
        print(S)
        break

# ============================================================
# БЛОК 8. УНИВЕРСАЛЬНАЯ РЕКУРСИЯ ДЛЯ СТРАТЕГИИ
# ============================================================
# Этот шаблон удобен для №20–21.
# В №19 демоверсии требуется существование подходящей партии,
# поэтому его лучше решать отдельным перебором первых двух ходов.

def f(a, b, m):
    if a + b >= 133:
        return m % 2 == 0

    if m == 0:
        return False

    h = [
        f(a + 4, b, m - 1),
        f(a * 2, b, m - 1),
        f(a, b + 4, m - 1),
        f(a, b * 2, m - 1)
    ]

    return any(h) if (m - 1) % 2 == 0 else all(h)

# ============================================================
# БЛОК 9. №20 ЧЕРЕЗ УНИВЕРСАЛЬНУЮ ФУНКЦИЮ
# ============================================================
ans20 = [
    S for S in range(1, 116)
    if f(17, S, 3) and not f(17, S, 1)
]

print(*ans20[:2])

# ============================================================
# БЛОК 10. №21 ЧЕРЕЗ УНИВЕРСАЛЬНУЮ ФУНКЦИЮ
# ============================================================
ans21 = [
    S for S in range(1, 116)
    if f(17, S, 4) and not f(17, S, 2)
]

print(ans21)
print(min(ans21))

